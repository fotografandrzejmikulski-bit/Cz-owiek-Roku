# Kopiuj do .env i wypełnij wartościami przed uruchomieniem docker-compose
# cp .env.example .env

# ── MAS Backend ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# LLM backend: mock | onnx | openai
LLM_BACKEND=mock
# OPENAI_API_KEY=sk-...
# ONNX_MODEL_PATH=models/llm.onnx

# Agent task delegation timeout (seconds)
AGENT_TASK_TIMEOUT=30

# ── gRPC ───────────────────────────────────────────────────────────────────
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# ── RabbitMQ ───────────────────────────────────────────────────────────────
RABBITMQ_USER=czlowiek
RABBITMQ_PASS=change_me_in_production

# Enable external RabbitMQ broker instead of in-process asyncio broker
USE_EXTERNAL_BROKER=false
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@rabbitmq/

# ── Deep Research ─────────────────────────────────────────────────────────
# Tavily Search API (wyszukiwarka AI dla agentów)
TAVILY_API_KEY=tvly-your-key-here

# Maks. równoległych wątków badawczych (Fan-out)
RESEARCH_MAX_PARALLEL=5

# Minimalny wynik jakości (0-100) do zatrzymania pętli refleksji Critic→Planner
RESEARCH_REFLECTION_THRESHOLD=75

# Maks. iteracji pętli refleksji
RESEARCH_MAX_ITERATIONS=3

# Model LLM dla szybkich pracowników (Worker); domyślnie: llm_backend
# np. LLM_WORKER_BACKEND=openai (a LLM_BACKEND=gemini dla planera)
LLM_WORKER_BACKEND=

# Gemini – dodatkowe modele
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-1.5-flash

# OpenAI – dodatkowe modele
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
