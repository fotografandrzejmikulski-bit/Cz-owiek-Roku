<!-- Okno czatu z agentami MAS – Człowiek Roku
     Plik: clients/desktop/ChatWindow.xaml
     Framework: WPF (.NET 8)
     Motyw: Catppuccin Mocha – zaawansowany ciemny interfejs w języku polskim -->
<Window x:Class="CzlowiekRoku.Desktop.MAS.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CzlowiekRoku.Desktop.MAS"
        Title="Człowiek Roku — System Wieloagentowy"
        Height="700" Width="980"
        MinHeight="500" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Window.Resources>
        <!-- ── Kolory motywu Catppuccin Mocha ── -->
        <SolidColorBrush x:Key="Base"      Color="#1E1E2E"/>
        <SolidColorBrush x:Key="Mantle"    Color="#181825"/>
        <SolidColorBrush x:Key="Crust"     Color="#11111B"/>
        <SolidColorBrush x:Key="Surface0"  Color="#313244"/>
        <SolidColorBrush x:Key="Surface1"  Color="#45475A"/>
        <SolidColorBrush x:Key="Overlay0"  Color="#6C7086"/>
        <SolidColorBrush x:Key="Text"      Color="#CDD6F4"/>
        <SolidColorBrush x:Key="Subtext1"  Color="#BAC2DE"/>
        <SolidColorBrush x:Key="Blue"      Color="#89B4FA"/>
        <SolidColorBrush x:Key="Lavender"  Color="#B4BEFE"/>
        <SolidColorBrush x:Key="Green"     Color="#A6E3A1"/>
        <SolidColorBrush x:Key="Yellow"    Color="#F9E2AF"/>
        <SolidColorBrush x:Key="Red"       Color="#F38BA8"/>
        <SolidColorBrush x:Key="Teal"      Color="#94E2D5"/>
        <SolidColorBrush x:Key="Peach"     Color="#FAB387"/>
        <SolidColorBrush x:Key="Mauve"     Color="#CBA6F7"/>

        <!-- ── Konwerter widoczności ── -->
        <local:BoolToAlignmentConverter x:Key="AlignConverter"/>

        <!-- ── Styl ScrollBar ── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource Mantle}"/>
            <Setter Property="Foreground" Value="{StaticResource Surface1}"/>
            <Setter Property="Width" Value="6"/>
        </Style>

        <!-- ── Styl elementu agenta na liście ── -->
        <Style x:Key="AgentListItem" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ── Bąbelek użytkownika ── -->
        <Style x:Key="UserBubble" TargetType="Border">
            <Setter Property="Background" Value="#4C6EF5"/>
            <Setter Property="CornerRadius" Value="14,14,2,14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="80,3,12,3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MaxWidth" Value="420"/>
        </Style>

        <!-- ── Bąbelek agenta ── -->
        <Style x:Key="AgentBubble" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface0}"/>
            <Setter Property="CornerRadius" Value="14,14,14,2"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="12,3,80,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth" Value="420"/>
        </Style>

        <!-- ── Styl przycisku akcji ── -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Lewy panel: lista agentów + budowniczy -->
            <ColumnDefinition Width="260" MinWidth="200" MaxWidth="360"/>
            <ColumnDefinition Width="4"/>
            <!-- Środek: czat -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════════════════════════════
             LEWY PANEL – Agenty + Budowniczy
        ════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" Background="{StaticResource Mantle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Nagłówek -->
                <RowDefinition Height="*"/>
                <!-- Lista agentów -->
                <RowDefinition Height="Auto"/>
                <!-- Budowniczy -->
            </Grid.RowDefinitions>

            <!-- Nagłówek panelu lewego -->
            <Border Grid.Row="0" Padding="14,12" Background="{StaticResource Crust}">
                <StackPanel>
                    <TextBlock Text="&#xE90B;  SYSTEM MAS"
                               Foreground="{StaticResource Blue}"
                               FontSize="11" FontWeight="Bold" LetterSpacing="1.5"/>
                    <TextBlock Text="Człowiek Roku — AAA"
                               Foreground="{StaticResource Subtext1}"
                               FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Lista agentów z rozwijającymi się kategoriami -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="8,8">
                <StackPanel>

                    <!-- Sekcja: Aktywne Agenty -->
                    <Expander IsExpanded="True"
                              Margin="0,0,0,6">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Green}"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="AKTYWNE AGENTY"
                                           Foreground="{StaticResource Subtext1}"
                                           FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                        </Expander.Header>
                        <ItemsControl x:Name="ActiveAgentsList"
                                      ItemsSource="{Binding ActiveAgents}"
                                      Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AgentListItem}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectAgentCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding AgentId}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0"
                                                     Width="7" Height="7"
                                                     Fill="{StaticResource Green}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding AgentId}"
                                                           Foreground="{StaticResource Text}"
                                                           FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Role}"
                                                           Foreground="{StaticResource Overlay0}"
                                                           FontSize="10"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding StatusLabel}"
                                                       Foreground="{StaticResource Teal}"
                                                       FontSize="9" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <!-- Sekcja: Możliwości -->
                    <Expander IsExpanded="False" Margin="0,0,0,6">
                        <Expander.Header>
                            <TextBlock Text="MOŻLIWOŚCI SYSTEMU"
                                       Foreground="{StaticResource Subtext1}"
                                       FontSize="10" FontWeight="Bold"/>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding AllCapabilities}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,3" Margin="0,1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="•"
                                                       Foreground="{StaticResource Mauve}"
                                                       Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{StaticResource Subtext1}"
                                                       FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                </StackPanel>
            </ScrollViewer>

            <!-- Budowniczy Agentów -->
            <Border Grid.Row="2"
                    Background="{StaticResource Crust}"
                    Padding="10,10">
                <StackPanel>
                    <TextBlock Text="&#xE8F4;  BUDOWNICZY AGENTÓW"
                               Foreground="{StaticResource Yellow}"
                               FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>

                    <TextBlock Text="Nazwa agenta (id):" Foreground="{StaticResource Subtext1}"
                               FontSize="10" Margin="0,0,0,2"/>
                    <TextBox x:Name="BuilderNameBox"
                             Text="{Binding NewAgentName, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource Surface0}"
                             Foreground="{StaticResource Text}"
                             BorderBrush="{StaticResource Surface1}"
                             FontSize="11" Padding="6,4" Margin="0,0,0,6"/>

                    <TextBlock Text="Rola:" Foreground="{StaticResource Subtext1}"
                               FontSize="10" Margin="0,0,0,2"/>
                    <TextBox x:Name="BuilderRoleBox"
                             Text="{Binding NewAgentRole, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource Surface0}"
                             Foreground="{StaticResource Text}"
                             BorderBrush="{StaticResource Surface1}"
                             FontSize="11" Padding="6,4" Margin="0,0,0,6"/>

                    <TextBlock Text="Możliwości (oddziel przecinkiem):"
                               Foreground="{StaticResource Subtext1}"
                               FontSize="10" Margin="0,0,0,2"/>
                    <TextBox x:Name="BuilderCapsBox"
                             Text="{Binding NewAgentCapabilities, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource Surface0}"
                             Foreground="{StaticResource Text}"
                             BorderBrush="{StaticResource Surface1}"
                             FontSize="11" Padding="6,4" Margin="0,0,0,6"/>

                    <TextBlock Text="Opis / zadanie agenta:"
                               Foreground="{StaticResource Subtext1}"
                               FontSize="10" Margin="0,0,0,2"/>
                    <TextBox x:Name="BuilderDescBox"
                             Text="{Binding NewAgentDescription, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource Surface0}"
                             Foreground="{StaticResource Text}"
                             BorderBrush="{StaticResource Surface1}"
                             FontSize="11" Padding="6,4" Margin="0,0,0,8"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="52"/>

                    <Button Content="+ Utwórz Agenta"
                            Command="{Binding BuildAgentCommand}"
                            Style="{StaticResource ActionButton}"
                            Background="{StaticResource Yellow}"
                            Foreground="{StaticResource Crust}"
                            FontWeight="Bold"
                            HorizontalAlignment="Stretch"/>

                    <!-- Status budowniczego -->
                    <TextBlock Text="{Binding BuilderStatusMessage}"
                               Foreground="{StaticResource Green}"
                               FontSize="10" Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding BuilderStatusMessage,
                                   Converter={StaticResource AlignConverter},
                                   ConverterParameter=String}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Separator (ruchomy) -->
        <GridSplitter Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource Surface0}"
                      ResizeDirection="Columns"/>

        <!-- ════════════════════════════════════════════════
             PRAWY PANEL – Czat
        ════════════════════════════════════════════════ -->
        <Grid Grid.Column="2" Background="{StaticResource Base}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Pasek tytułu czatu -->
                <RowDefinition Height="*"/>
                <!-- Wiadomości -->
                <RowDefinition Height="Auto"/>
                <!-- Pole input -->
            </Grid.RowDefinitions>

            <!-- Pasek tytułu czatu -->
            <Border Grid.Row="0" Background="{StaticResource Mantle}" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Rozmowa z Agentami"
                                   Foreground="{StaticResource Text}"
                                   FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ActiveAgentLabel"
                                   Text="{Binding ChatSubtitle}"
                                   Foreground="{StaticResource Overlay0}"
                                   FontSize="10"/>
                    </StackPanel>
                    <!-- LLM backend badge -->
                    <Border Grid.Column="1"
                            Background="{StaticResource Surface0}"
                            CornerRadius="10" Padding="8,3"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LLM: " Foreground="{StaticResource Overlay0}" FontSize="10"/>
                            <TextBlock Text="{Binding LlmBackendLabel}"
                                       Foreground="{StaticResource Mauve}"
                                       FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Lista wiadomości -->
            <ScrollViewer Grid.Row="1"
                          x:Name="MessagesScroll"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,8">
                <ItemsControl x:Name="MessagesControl"
                              ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <!-- Bąbelek użytkownika (prawa strona) -->
                                <Border Style="{StaticResource UserBubble}"
                                        Visibility="{Binding IsFromUser,
                                            Converter={StaticResource AlignConverter},
                                            ConverterParameter=Visible}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayLabel}"
                                                   Foreground="#93AAFF" FontSize="9"
                                                   Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="White" FontSize="13"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Bąbelek agenta (lewa strona) -->
                                <Border Style="{StaticResource AgentBubble}"
                                        Visibility="{Binding IsFromUser,
                                            Converter={StaticResource AlignConverter},
                                            ConverterParameter=Collapsed}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayLabel}"
                                                   Foreground="{StaticResource Teal}"
                                                   FontSize="9" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="{StaticResource Text}"
                                                   FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Pole wprowadzania tekstu -->
            <Border Grid.Row="2" Background="{StaticResource Mantle}" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Podpowiedź intencji -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding IntentHint}"
                               Foreground="{StaticResource Overlay0}"
                               FontSize="10" Margin="2,0,0,4"
                               Visibility="{Binding IntentHint,
                                   Converter={StaticResource AlignConverter},
                                   ConverterParameter=String}"/>

                    <!-- TextBox -->
                    <Border Grid.Row="1" Grid.Column="0"
                            Background="{StaticResource Surface0}"
                            CornerRadius="8" BorderBrush="{StaticResource Surface1}"
                            BorderThickness="1">
                        <TextBox x:Name="InputBox"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 Foreground="{StaticResource Text}"
                                 CaretBrush="{StaticResource Text}"
                                 BorderThickness="0"
                                 Padding="10,8"
                                 FontSize="13"
                                 KeyDown="InputBox_KeyDown"
                                 TextChanged="InputBox_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Tag"
                                                    Value="Napisz wiadomosc lub zlec zadanie agentom... (Enter = wyslij)"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Border>

                    <!-- Przycisk Wyślij -->
                    <Button Grid.Row="1" Grid.Column="1"
                            Content="Wyslij"
                            Command="{Binding SendCommand}"
                            Style="{StaticResource ActionButton}"
                            Background="#4C6EF5"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="13"
                            Margin="8,0,0,0"
                            MinWidth="80"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>


    <Window.Resources>
        <!-- Styl bąbelka wiadomości użytkownika (wyrównanie prawe) -->
        <Style x:Key="UserBubble" TargetType="Border">
            <Setter Property="Background" Value="#4C6EF5"/>
            <Setter Property="CornerRadius" Value="12,12,2,12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="60,4,8,4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MaxWidth" Value="320"/>
        </Style>

        <!-- Styl bąbelka wiadomości agenta (wyrównanie lewe) -->
        <Style x:Key="AgentBubble" TargetType="Border">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="CornerRadius" Value="12,12,12,2"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="8,4,60,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth" Value="320"/>
        </Style>

        <!-- Konwerter bool → HorizontalAlignment (Right dla user, Left dla agenta) -->
        <local:BoolToAlignmentConverter x:Key="AlignConverter"/>

        <!-- Selektor stylu bąbelka -->
        <local:ChatBubbleStyleSelector x:Key="BubbleStyleSelector"
                                       UserStyle="{StaticResource UserBubble}"
                                       AgentStyle="{StaticResource AgentBubble}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <Border Grid.Row="0" Background="#181825" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="#A6E3A1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Czat z Agentami MAS"
                           Foreground="#CDD6F4" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Lista wiadomości -->
        <ScrollViewer Grid.Row="1"
                      x:Name="MessagesScroll"
                      VerticalScrollBarVisibility="Auto"
                      Padding="4,4">
            <ItemsControl x:Name="MessagesControl"
                          ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <!-- Bąbelek użytkownika -->
                            <Border Style="{StaticResource UserBubble}"
                                    Visibility="{Binding IsFromUser,
                                        Converter={StaticResource AlignConverter},
                                        ConverterParameter=Visible}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayLabel}"
                                               Foreground="#BAC2DE" FontSize="9"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="#FFFFFF" FontSize="13"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Bąbelek agenta -->
                            <Border Style="{StaticResource AgentBubble}"
                                    Visibility="{Binding IsFromUser,
                                        Converter={StaticResource AlignConverter},
                                        ConverterParameter=Collapsed}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayLabel}"
                                               Foreground="#89DCEB" FontSize="9"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="#CDD6F4" FontSize="13"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Pasek inputu -->
        <Border Grid.Row="2" Background="#181825" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="InputBox"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="False"
                         VerticalAlignment="Center"
                         Background="#313244"
                         Foreground="#CDD6F4"
                         CaretBrush="#CDD6F4"
                         BorderBrush="#45475A"
                         BorderThickness="1"
                         Padding="8,6"
                         FontSize="13"
                         CornerRadius="6"
                         KeyDown="InputBox_KeyDown">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Tag" Value="Napisz wiadomość... (Enter = wyślij)"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Button Grid.Column="1"
                        Content="Wyślij"
                        Command="{Binding SendCommand}"
                        Margin="8,0,0,0"
                        Padding="14,6"
                        Background="#4C6EF5"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#5C7EFF"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#45475A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
