<!-- Okno czatu z agentami MAS – Człowiek Roku
     Plik: clients/desktop/ChatWindow.xaml
     Framework: WPF (.NET 8) -->
<Window x:Class="CzlowiekRoku.Desktop.MAS.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CzlowiekRoku.Desktop.MAS"
        Title="Człowiek Roku – Czat z Agentami"
        Height="600" Width="480"
        MinHeight="400" MinWidth="320"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Window.Resources>
        <!-- Styl bąbelka wiadomości użytkownika (wyrównanie prawe) -->
        <Style x:Key="UserBubble" TargetType="Border">
            <Setter Property="Background" Value="#4C6EF5"/>
            <Setter Property="CornerRadius" Value="12,12,2,12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="60,4,8,4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MaxWidth" Value="320"/>
        </Style>

        <!-- Styl bąbelka wiadomości agenta (wyrównanie lewe) -->
        <Style x:Key="AgentBubble" TargetType="Border">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="CornerRadius" Value="12,12,12,2"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="8,4,60,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth" Value="320"/>
        </Style>

        <!-- Konwerter bool → HorizontalAlignment (Right dla user, Left dla agenta) -->
        <local:BoolToAlignmentConverter x:Key="AlignConverter"/>

        <!-- Selektor stylu bąbelka -->
        <local:ChatBubbleStyleSelector x:Key="BubbleStyleSelector"
                                       UserStyle="{StaticResource UserBubble}"
                                       AgentStyle="{StaticResource AgentBubble}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <Border Grid.Row="0" Background="#181825" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="#A6E3A1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Czat z Agentami MAS"
                           Foreground="#CDD6F4" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Lista wiadomości -->
        <ScrollViewer Grid.Row="1"
                      x:Name="MessagesScroll"
                      VerticalScrollBarVisibility="Auto"
                      Padding="4,4">
            <ItemsControl x:Name="MessagesControl"
                          ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <!-- Bąbelek użytkownika -->
                            <Border Style="{StaticResource UserBubble}"
                                    Visibility="{Binding IsFromUser,
                                        Converter={StaticResource AlignConverter},
                                        ConverterParameter=Visible}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayLabel}"
                                               Foreground="#BAC2DE" FontSize="9"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="#FFFFFF" FontSize="13"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Bąbelek agenta -->
                            <Border Style="{StaticResource AgentBubble}"
                                    Visibility="{Binding IsFromUser,
                                        Converter={StaticResource AlignConverter},
                                        ConverterParameter=Collapsed}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayLabel}"
                                               Foreground="#89DCEB" FontSize="9"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="#CDD6F4" FontSize="13"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Pasek inputu -->
        <Border Grid.Row="2" Background="#181825" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="InputBox"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="False"
                         VerticalAlignment="Center"
                         Background="#313244"
                         Foreground="#CDD6F4"
                         CaretBrush="#CDD6F4"
                         BorderBrush="#45475A"
                         BorderThickness="1"
                         Padding="8,6"
                         FontSize="13"
                         CornerRadius="6"
                         KeyDown="InputBox_KeyDown">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Tag" Value="Napisz wiadomość... (Enter = wyślij)"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Button Grid.Column="1"
                        Content="Wyślij"
                        Command="{Binding SendCommand}"
                        Margin="8,0,0,0"
                        Padding="14,6"
                        Background="#4C6EF5"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#5C7EFF"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#45475A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
